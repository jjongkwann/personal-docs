# API 키 불필요 — 100% 로컬

# Elasticsearch
ES_HOST=http://localhost:9200
ES_INDEX=pkb_documents

# (선택) 데이터 코퍼스 루트 (기본: 프로젝트 내 data/).
# 볼트 하위 폴더로 지정하는 것을 권장 — 코퍼스 자체가 볼트 안에 있어 Obsidian으로 바로 열람/편집.
# doc_id는 위치와 무관하게 항상 data/<카테고리>/... 형식.
# DATA_ROOT=/Users/me/Documents/ObsidianVault/PKB

# (선택) DATA_ROOT 밖에 남겨둔 볼트 파일도 같이 색인하고 싶을 때만 설정 (보통 불필요).
# 설정 시 pkb init에서 초기 인제스트(category=obsidian). DATA_ROOT 서브트리는 자동 제외.
# OBSIDIAN_PATH=/Users/me/Documents/ObsidianVault

# 검색 파이프라인
RERANK_ENABLED=true
# EMBED_CONTEXT_PREFIX=false  # true면 임베딩 입력에 title·section_path prefix 포함 (변경 시 다음 sync에서 전량 재임베딩)
CANDIDATE_K=20              # 기본 경로(rerank=on) 벤치 기준 ck=50 대비 latency 2.4x↓, 품질 동일. 더 큰 후보 풀이 필요하면 50으로 상향.
EXPAND_CONTEXT=0            # N>0이면 검색 결과마다 전후 N청크를 neighbors로 부착

# 개념 그래프 (Graph RAG) — DATA_ROOT를 옮겼다면 같이 옮기는 것을 권장
GRAPH_DB_PATH=data/.graph/pkb_graph.sqlite
GRAPH_DEDUP_THRESHOLD=0.88

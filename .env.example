# API 키 불필요 — 100% 로컬

# Elasticsearch
ES_HOST=http://localhost:9200
ES_INDEX=pkb_documents

# (선택) 데이터 코퍼스 루트 (기본: 프로젝트 내 data/).
# 볼트 하위 폴더로 지정하는 것을 권장 — 코퍼스 자체가 볼트 안에 있어 Obsidian으로 바로 열람/편집.
# doc_id는 위치와 무관하게 항상 data/<카테고리>/... 형식.
# 주의: ~/Documents·~/Desktop·~/Downloads 등 macOS TCC 보호 경로는 피할 것 —
# launchd로 띄운 서버는 승인 프롬프트 없이 open()이 영구 블록된다(거부도 아니고 무한 대기).
# DATA_ROOT=/Users/me/workspace/ObsidianVault/PKB

# (선택) DATA_ROOT 밖에 남겨둔 볼트 파일도 같이 색인하고 싶을 때만 설정 (보통 불필요).
# 설정 시 pkb init에서 초기 인제스트. doc_id는 obsidian/<상대경로>, 카테고리는 볼트 최상위
# 폴더명에서 동적 결정(data/와 동일 규칙). DATA_ROOT 서브트리는 자동 제외.
# OBSIDIAN_PATH=/Users/me/workspace/ObsidianVault

# 검색 파이프라인
# EMBEDDING_PROVIDER=local   # 초기 구성. 운영 중 Ollama 전환은 앱의 설정 → 검색 임베딩 사용
# Ollama IP로 모델 조회 → 적용하고 재색인: 텍스트·개념 벡터를 별도 저장소에 만든 뒤 함께 전환.
# 활성 구성은 GRAPH_DB_PATH 부모의 .embedding-runtime/active.json이 관리한다.
# 선택 후에는 .env의 ES_INDEX/GRAPH_DB_PATH를 새 저장소 경로로 바꾸지 않는다.
# 수동 .env 편집으로 모델을 바꾸면 기존 벡터와 질의 벡터가 섞일 수 있다.
# 자세한 절차와 보존 정책: docs/windows-ollama-embeddings.md
# EMBEDDING_MODEL=BAAI/bge-m3  # 변경 시 EMBEDDING_DIMS도 함께, 다음 sync에서 전량 재임베딩
# EMBEDDING_REVISION=          # 선택: 모델 저장소 commit/tag. 변경 시 다음 sync에서 전량 재임베딩
# EMBEDDING_BATCH_SIZE=32     # 대량 색인의 피크 메모리를 좌우. RAM 8GB 머신에선 8로 낮출 것
# EMBEDDING_DTYPE=float16     # GPU(mps·cuda)에서 가중치 정밀도: float16·bfloat16·float32. CPU는 항상 float32. 재색인 불필요
# EMBEDDING_DIMS=1024
# EMBED_CONTEXT_PREFIX=true   # 임베딩 입력에 title·section_path prefix 포함 (변경 시 전량 재임베딩)
# 질의·문서 프롬프트가 다른 모델 예: EmbeddingGemma 2 (768차원, 글·이미지·오디오를 한 모델이 임베딩)
# EMBEDDING_MODEL=google/embeddinggemma-2
# EMBEDDING_DIMS=768
# EMBEDDING_DTYPE=bfloat16     # float16에서는 NaN이나 망가진 벡터가 나온다
# EMBEDDING_TEXT_ONLY=true     # 이미지·오디오 인코더 없이 텍스트 탑만 올린다 (740M → 270M). 재색인 불필요
# EMBEDDING_QUERY_PROMPT=SearchQuery
# EMBEDDING_DOCUMENT_PROMPT=Document
# EMBEDDING_NORMALIZE=true
RERANK_ENABLED=false        # 자체 벤치에서 무재순위가 품질·지연 모두 우위 (docs/architecture.md)
# RERANK_REVISION=            # 선택: 리랭커 모델 저장소 commit/tag 고정
CANDIDATE_K=20              # ck=50 대비 latency 2.4x↓, 품질 동일. 더 큰 후보 풀이 필요하면 50으로 상향.
EXPAND_CONTEXT=0            # N>0이면 검색 결과마다 전후 N청크를 neighbors로 부착

# MCP 서버
MCP_PORT=8787               # 공유 HTTP MCP 서버 포트
# MCP_HOST=127.0.0.1        # 바인딩 주소. 서버를 별도 머신에 두고 LAN/VPN에서 붙을 때만 0.0.0.0.
                            # 인증이 없고 write_file로 볼트 전체를 쓸 수 있으니 신뢰망 안에서만 열 것.
# WARMUP_ON_START=false     # 기동 시 모델 예열. 끄면 첫 검색까지 서버가 ~50MB로 유휴
# MODEL_IDLE_SECONDS=300    # 마지막 사용 뒤 이 시간(초)이 지나면 모델을 내려 메모리를 돌려준다. 0이면 계속 유지

# (선택) 볼트 밖 첨부 폴더 — put_attachment/get_attachment. 비우면 꺼짐
# ATTACHMENTS_ROOT=/Volumes/PKBData/attachments

# (선택) 이미지·오디오 검색 — 벡터는 다른 Mac의 `pkb media-sync`가 만들어 올린다. 비우면 꺼짐.
# EMBEDDING_MODEL도 google/embeddinggemma-2(EMBEDDING_TASK는 비움)일 때만 받는다.
# MEDIA_EMBEDDING_MODEL=google/embeddinggemma-2

# 개념 그래프 (Graph RAG) — DATA_ROOT를 옮겼다면 같이 옮기는 것을 권장
GRAPH_DB_PATH=data/.graph/pkb_graph.sqlite
GRAPH_DEDUP_THRESHOLD=0.88

# 정상 증분 그래프 CLI(`pkb graph extract`)는 Ollama HTTP API를 직접 사용한다.
# `pkb graph models`에서 generation=true인 정확한 설치 태그를 선택한다 (Claude/Codex 실행 불필요).
# 검색 임베딩 설정과는 별개이며 모델 변경만으로 기존 그래프를 다시 추출하지 않는다.
# GRAPH_OLLAMA_ENDPOINT=http://192.168.0.2:11434
# GRAPH_OLLAMA_MODEL=gemma4:12b-it-qat
# GRAPH_OLLAMA_CONTEXT=4096
# GRAPH_OLLAMA_OUTPUT=1024
# GRAPH_OLLAMA_TIMEOUT=180
# 먼저 --doc-id data/... --max-chunks 1 --output 1024로 추출·원문 대조 후 범위를 늘린다.
# 실패 기록: pkb graph extraction-runs --run-id RUN_ID / 재개: pkb graph extract --resume RUN_ID
# resume은 기록된 모델·주소·문맥·배치를 유지한다. 새 설정 적용은 새 실행으로 한다.

# 새로 색인한 본문을 독립 worker가 자동 그래프 추출 (기본 false)
# GRAPH_AUTO_EXTRACT=true
# uv run pkb graph worker --interval 20
# uv run pkb graph worker-status
